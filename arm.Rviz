location : five_dof_arm/rviz/arm.rviz

Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views

Visualization Manager:
  Class: ""

  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 0.5

    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description

    - Class: rviz/TF
      Name: TF
      Enabled: true

  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30

  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.5
      Pitch: 0.7
      Yaw: 0.8
